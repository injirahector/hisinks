PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/his-inks

JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Google OAuth — obtain from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# ── Email (Nodemailer + Gmail SMTP) ──────────────────────────────────────────
# EMAIL_USER: Gmail address that sends the reset emails.
# EMAIL_PASS: Gmail App Password (NOT your normal Gmail password).
#             Generate at: Google Account → Security → 2-Step Verification
#             → App passwords → Mail → Generate.
#             2-Step Verification must be enabled on the Gmail account first.
# EMAIL_FROM: display name shown to the email recipient.
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=
EMAIL_FROM=His Inks <your-gmail@gmail.com>

# ── Password Reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRES_MINUTES=15
# Local dev: http://localhost:5173   Production: https://hisinks.vercel.app
CLIENT_URL=http://localhost:5173
